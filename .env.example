# GitHub App 설정 (필수 — 누락 시 서버 시작 실패)
APP_ID=123456
APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=your_webhook_secret_here

# 알림 Issue를 생성할 리포 (org/repo 형식)
NOTIFY_REPO=your-org/ops-repo

# GitHub API 엔드포인트 (기본값: GitHub.com)
# GHES(GitHub Enterprise Server) 사용 시 아래 주석을 해제하고 hostname을 변경
# GITHUB_API_URL=https://github.example.com/api/v3

# 로그 설정
# LOG_FILE_NAME 미설정 시 콘솔 출력만. 설정 시 콘솔 + logs/{LOG_FILE_NAME} 동시 출력
# LOG_FILE_NAME=app.log
# LOG_ROTATION_WHEN=midnight   # 로테이션 주기: midnight, h, d, w0~w6 (기본: midnight)
# LOG_ROTATION_BACKUP_COUNT=30 # 보관할 로테이션 파일 수 (기본: 30)

# Audit Log 폴링 주기 (분 단위, 기본 5)
AUDIT_POLL_INTERVAL_MINUTES=5

# Docker 이미지 태그 (기본값: latest)
TAG=latest
